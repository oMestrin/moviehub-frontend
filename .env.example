# URL do BFF pelo Azure API Management (o microfrontend só fala com o BFF)
VITE_BFF_URL=http://localhost:3000
# Chave de assinatura do produto do API Management (vazia em ambiente local)
VITE_APIM_SUBSCRIPTION_KEY=
# Opcional: URLs dos remotes quando publicados separadamente (padrão: /mfe-catalogo/ e /mfe-avaliacoes/ no mesmo site)
VITE_REMOTE_CATALOGO_URL=
VITE_REMOTE_AVALIACOES_URL=
